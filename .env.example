# Credential template -- copy to .env and fill in your own values.
# .env is git-ignored; this template is safe to commit.

# IBM Quantum Platform token (https://quantum.ibm.com, free Open Plan)
QISKIT_IBM_TOKEN=

# ANU Quantum Numbers API key (https://quantumnumbers.anu.edu.au, free signup)
# Optional: only used by qrng_harvest.py --source aqn
ANU_AQN_API_KEY=

# SpinQ Triangulum Pro on the local network (optional)
SPINQ_IP=192.168.137.1
SPINQ_PORT=55444
SPINQ_ACCOUNT=
SPINQ_PASSWORD=
